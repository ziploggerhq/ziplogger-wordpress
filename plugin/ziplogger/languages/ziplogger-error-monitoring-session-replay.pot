msgid "Report LCP, INP, CLS, FCP and TTFB (Google's web-vitals library)"
msgstr ""

#: includes/admin/class-module-specs.php:130
msgid "Performance sampling"
msgstr ""

#: includes/admin/class-module-specs.php:134
